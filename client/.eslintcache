,"D:\\My projects\\Make-it-happen\\development\\client\\src\\App.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\serviceWorkerRegistration.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\reportWebVitals.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\store\\configureStore.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\reducers\\rootReducer.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\pages\\Home.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\pages\\GoalsPage.jsx",["278"],"import React, { useEffect, useState, useMemo } from \"react\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { useParams } from \"react-router-dom\";\r\nimport {\r\n  Box,\r\n  Container,\r\n  Flex,\r\n  Heading,\r\n  Text,\r\n  VStack,\r\n  Spinner,\r\n  Center,\r\n} from \"@chakra-ui/react\";\r\nimport ModalAddGoal from \"../components/goal/ModalAddGoal\";\r\nimport GoalLT from \"../components/goal/GoalLT\";\r\nimport { loadGoals } from \"../actions/goal_actions\";\r\nimport { loadActions } from \"../actions/action_actions\";\r\nimport { loadFields } from \"../actions/field_actions\";\r\nimport PlanIcon from \"../icons/PlanIcon.jsx\";\r\nimport \"./Goalspage.css\";\r\n\r\nexport default function GoalsPage() {\r\n  const { fieldId } = useParams();\r\n  const dispatch = useDispatch();\r\n\r\n  // Safe selectors with fallbacks to avoid undefined crashes\r\n  const fieldState = useSelector((state) => state.field || {});\r\n  const goalState = useSelector((state) => state.goal || state.goals || {});\r\n\r\n  const loadingGoal = goalState.loadingGoal;\r\n\r\n  // Extract goals safely whether payload is flat or nested\r\n  const rawGoals = goalState.goals || goalState.data || goalState;\r\n  const safeGoalsArray = useMemo(() => {\r\n    if (Array.isArray(rawGoals)) return rawGoals;\r\n    if (rawGoals && Array.isArray(rawGoals.goals)) return rawGoals.goals;\r\n    if (rawGoals && Array.isArray(rawGoals.data)) return rawGoals.data;\r\n    return [];\r\n  }, [rawGoals]);\r\n\r\n  // Derive long-term goals efficiently\r\n  const listGoalLT = useMemo(() => {\r\n    return safeGoalsArray.filter(\r\n      (goal) =>\r\n        goal?.category?.toLowerCase() === \"long term\" ||\r\n        goal?.type?.toLowerCase() === \"long term\",\r\n    );\r\n  }, [safeGoalsArray]);\r\n\r\n  // Safely derive current field name without triggering infinite re-renders\r\n  const fieldName = useMemo(() => {\r\n    const fieldsList = fieldState.name || fieldState.fields || [];\r\n    if (!Array.isArray(fieldsList) || !fieldId) return \"\";\r\n    const activeField = fieldsList.find(\r\n      (el) => el._id === fieldId || el.id === fieldId,\r\n    );\r\n    return activeField?.name ? activeField.name.toLowerCase() : \"\";\r\n  }, [fieldState, fieldId]);\r\n\r\n  useEffect(() => {\r\n    dispatch(loadFields());\r\n    if (fieldId) {\r\n      dispatch(loadGoals(fieldId));\r\n      dispatch(loadActions(fieldId));\r\n    }\r\n  }, [dispatch, fieldId]);\r\n\r\n  return (\r\n    <Box minH=\"100vh\" bg=\"gray.50/50\" py={8} className=\"GoalsPage\">\r\n      <Container\r\n        maxW={{ base: \"100%\", md: \"75%\", lg: \"70%\" }}\r\n        mx=\"auto\"\r\n        px={{ base: 4, md: 0 }}\r\n      >\r\n        {/* Header Section */}\r\n        <Flex\r\n          bg=\"white\"\r\n          backdropFilter=\"blur(10px)\"\r\n          border=\"1px solid\"\r\n          borderColor=\"gray.100\"\r\n          boxShadow=\"sm\"\r\n          borderRadius=\"2xl\"\r\n          p={6}\r\n          mb={8}\r\n          align=\"center\"\r\n          justify=\"space-between\"\r\n          className=\"GoalsPage__header\"\r\n        >\r\n          <Flex align=\"center\" gap={4} className=\"GoalsPage__title\">\r\n            <Center\r\n              p={3}\r\n              bg=\"blue.50\"\r\n              borderRadius=\"xl\"\r\n              color=\"blue.500\"\r\n              w=\"50px\"\r\n              h=\"50px\"\r\n              flexShrink={0}\r\n            >\r\n              <PlanIcon color=\"#3182CE\" />\r\n            </Center>\r\n\r\n            <Flex direction=\"column\" justify=\"center\" h=\"50px\">\r\n              <Text\r\n                fontSize=\"xs\"\r\n                fontWeight=\"bold\"\r\n                textTransform=\"uppercase\"\r\n                color=\"gray.400\"\r\n                letterSpacing=\"wider\"\r\n                lineHeight=\"1\"\r\n                mb={1.5}\r\n              >\r\n                Life Area Focus\r\n              </Text>\r\n              <Heading\r\n                as=\"h1\"\r\n                size=\"lg\"\r\n                fontWeight=\"extrabold\"\r\n                color=\"gray.800\"\r\n                textTransform=\"capitalize\"\r\n                lineHeight=\"1\"\r\n              >\r\n                {fieldName || \"Loading Area...\"}\r\n              </Heading>\r\n            </Flex>\r\n          </Flex>\r\n\r\n          <ModalAddGoal\r\n            fieldId={fieldId}\r\n            category=\"long term\"\r\n            parentId={fieldId}\r\n          />\r\n        </Flex>\r\n\r\n        {/* Dynamic Card Goals Section Wrapper */}\r\n        <Box className=\"GoalsPage__goals\" w=\"100%\">\r\n          {loadingGoal ? (\r\n            <Center py={16}>\r\n              <Spinner size=\"xl\" color=\"blue.500\" thickness=\"4px\" />\r\n            </Center>\r\n          ) : listGoalLT.length > 0 ? (\r\n            <VStack spacing={6} align=\"stretch\" w=\"100%\">\r\n              {listGoalLT.map((goal) => (\r\n                <GoalLT key={goal._id || goal.id} data={{ ...goal, fieldId }} />\r\n              ))}\r\n            </VStack>\r\n          ) : (\r\n            <Center\r\n              flexDirection=\"column\"\r\n              bg=\"white\"\r\n              border=\"2px dashed\"\r\n              borderColor=\"gray.200\"\r\n              borderRadius=\"2xl\"\r\n              py={16}\r\n              px={6}\r\n              w=\"100%\"\r\n            >\r\n              <Heading\r\n                as=\"h3\"\r\n                size=\"md\"\r\n                color=\"gray.400\"\r\n                fontWeight=\"semibold\"\r\n                mb={2}\r\n              >\r\n                No strategic goals created yet\r\n              </Heading>\r\n              <Text color=\"gray.400\" fontSize=\"sm\">\r\n                Click the add button above to establish your first long term\r\n                milestone.\r\n              </Text>\r\n            </Center>\r\n          )}\r\n        </Box>\r\n      </Container>\r\n    </Box>\r\n  );\r\n}\r\n","D:\\My projects\\Make-it-happen\\development\\client\\src\\pages\\FieldPage.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\pages\\CheckoutFail.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\pages\\CheckoutSuccess.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\chat\\Chat.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\nav\\header\\Header.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\reducers\\goalReducer.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\reducers\\authReducer.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\reducers\\asyncReducer.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\reducers\\quoteReducer.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\reducers\\actionReducer.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\reducers\\promodoroReducer.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\reducers\\fieldReducer.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\reducers\\chatReducer.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\icons\\PlanIcon.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\icons\\ToolsIcon.jsx",[],["279","280"],"D:\\My projects\\Make-it-happen\\development\\client\\src\\actions\\field_actions.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\actions\\goal_actions.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\actions\\loadQuote.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\actions\\action_actions.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\actions\\auth_actions.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\actions\\payment_actions.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\actions\\chat_actions.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\actions\\actionsTypes.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\chat\\Discussion.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\chat\\Sidebar.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\icons\\GrowthIcon.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\icons\\FunIcon.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\icons\\RelationsIcon.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\icons\\HealthIcon.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\icons\\CareerIcon.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\icons\\FinanceIcon.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\homePage\\Tool.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\homePage\\Synergy.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\homePage\\Dream.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\homePage\\Plan.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\homePage\\Footer.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\goal\\ModalAddGoal.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\goal\\Partners.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\goal\\GoalLT.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\field\\Field.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\tools\\Promodoro.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\field\\ModalAddField.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\action\\Action.jsx",["281"],"import React, { useState } from \"react\";\r\nimport {\r\n  Checkbox,\r\n  Box,\r\n  Flex,\r\n  Text,\r\n  IconButton,\r\n  HStack,\r\n  Badge,\r\n} from \"@chakra-ui/react\";\r\nimport { EditIcon, DeleteIcon, TimeIcon } from \"@chakra-ui/icons\";\r\nimport \"./Action.css\";\r\nimport ModalDeleteAction from \"./ModalDeleteAction\";\r\nimport ModalEditAction from \"./ModalEditAction\";\r\nimport { format } from \"date-fns\";\r\nimport { editAction } from \"../../actions/action_actions\";\r\nimport { useDispatch } from \"react-redux\";\r\n\r\nfunction Action({ action = {} }) {\r\n  const [openModalEdit, setOpenModalEdit] = useState(false);\r\n  const [openModalDelete, setOpenModalDelete] = useState(false);\r\n  const dispatch = useDispatch();\r\n\r\n  if (!action || typeof action !== \"object\") return null; // Guard clause\r\n\r\n  const {\r\n    description = \"\",\r\n    startDate,\r\n    priority = \"low\",\r\n    type,\r\n    completed = {},\r\n    _id,\r\n    fieldId,\r\n  } = action;\r\n\r\n  const isCompletedToday = Boolean(completed?.status);\r\n\r\n  const handleModalDelete = (e) => {\r\n    setOpenModalDelete(!openModalDelete);\r\n  };\r\n\r\n  const handleModalEdit = (e) => {\r\n    setOpenModalEdit(!openModalEdit);\r\n  };\r\n\r\n  const updateCompletedStatus = async (e) => {\r\n    try {\r\n      dispatch(\r\n        editAction({\r\n          ...action,\r\n          completed: {\r\n            status: !isCompletedToday,\r\n            completionDate: action.completed.completionDate,\r\n          },\r\n        }),\r\n      );\r\n    } catch (err) {\r\n      console.error(err);\r\n    }\r\n  };\r\n\r\n  const getThemeColors = () => {\r\n    if (isCompletedToday)\r\n      return {\r\n        border: \"green.400\",\r\n        bg: \"green.50\",\r\n        glow: \"rgba(72, 187, 120, 0.15)\",\r\n      };\r\n    const p = priority?.toLowerCase();\r\n    if (p === \"high\")\r\n      return {\r\n        border: \"red.400\",\r\n        bg: \"red.50\",\r\n        glow: \"rgba(245, 101, 101, 0.15)\",\r\n      };\r\n    if (p === \"medium\")\r\n      return {\r\n        border: \"orange.400\",\r\n        bg: \"orange.50\",\r\n        glow: \"rgba(237, 137, 54, 0.15)\",\r\n      };\r\n    return {\r\n      border: \"gray.300\",\r\n      bg: \"gray.50\",\r\n      glow: \"rgba(160, 174, 192, 0.1)\",\r\n    };\r\n  };\r\n\r\n  const colors = getThemeColors();\r\n\r\n  return (\r\n    <Box\r\n      className=\"action__glass-card\"\r\n      w=\"100%\"\r\n      p={6}\r\n      mb={4}\r\n      bg={isCompletedToday ? colors.bg : \"white\"}\r\n      border=\"1px solid\"\r\n      borderColor={isCompletedToday ? \"green.200\" : \"gray.100\"}\r\n      borderLeft=\"6px solid\"\r\n      borderLeftColor={colors.border}\r\n      borderRadius=\"2xl\"\r\n      boxShadow={`0 10px 25px -5px ${colors.glow}, 0 8px 10px -6px rgba(0,0,0,0.03)`}\r\n      _hover={{\r\n        transform: \"translateY(-4px)\",\r\n        boxShadow: `0 20px 35px -5px ${colors.glow}, 0 12px 16px -8px rgba(0,0,0,0.05)`,\r\n        borderColor: isCompletedToday ? \"green.300\" : \"gray.200\",\r\n      }}\r\n      transition=\"all 0.3s cubic-bezier(0.4, 0, 0.2, 1)\"\r\n    >\r\n      <Flex direction=\"column\" gap={4} w=\"100%\">\r\n        {/* Main Row: Checkbox, Text Description, and Management Controls */}\r\n        <Flex\r\n          width=\"100%\"\r\n          alignItems=\"start\"\r\n          justifyContent=\"space-between\"\r\n          gap={4}\r\n        >\r\n          <HStack spacing={4} alignItems=\"start\" flex=\"1\">\r\n            <Checkbox\r\n              id={`cb-${_id}`}\r\n              isChecked={isCompletedToday}\r\n              onChange={updateCompletedStatus}\r\n              colorScheme=\"green\"\r\n              size=\"lg\"\r\n              mt=\"3px\"\r\n              transform=\"scale(1.2)\"\r\n              borderRadius=\"md\"\r\n            />\r\n            <Text\r\n              className=\"action__description\"\r\n              color={isCompletedToday ? \"gray.400\" : \"gray.800\"}\r\n              fontWeight=\"bold\"\r\n              fontSize=\"lg\"\r\n              lineHeight=\"base\"\r\n              letterSpacing=\"wide\"\r\n            >\r\n              {description}\r\n            </Text>\r\n          </HStack>\r\n\r\n          {/* Quick Control Buttons Panel */}\r\n          <HStack spacing={1} shrink={0} bg=\"gray.50\" borderRadius=\"xl\" p={1}>\r\n            <IconButton\r\n              icon={<EditIcon />}\r\n              size=\"sm\"\r\n              variant=\"ghost\"\r\n              colorScheme=\"blue\"\r\n              onClick={handleModalEdit}\r\n              aria-label=\"Edit action\"\r\n              borderRadius=\"lg\"\r\n            />\r\n            <ModalEditAction\r\n              openModalEdit={openModalEdit}\r\n              handleModalEdit={handleModalEdit}\r\n              data={action}\r\n            />\r\n\r\n            <IconButton\r\n              icon={<DeleteIcon />}\r\n              size=\"sm\"\r\n              variant=\"ghost\"\r\n              colorScheme=\"red\"\r\n              onClick={handleModalDelete}\r\n              aria-label=\"Delete action\"\r\n              borderRadius=\"lg\"\r\n            />\r\n            <ModalDeleteAction\r\n              openModalDelete={openModalDelete}\r\n              handleModalDelete={handleModalDelete}\r\n              data={action}\r\n            />\r\n          </HStack>\r\n        </Flex>\r\n\r\n        {/* Footer Row: Categories and timestamps */}\r\n        <Flex\r\n          justify=\"space-between\"\r\n          alignItems=\"center\"\r\n          borderTop=\"1px dashed\"\r\n          borderColor=\"gray.100\"\r\n          pt={3}\r\n        >\r\n          <HStack spacing={3}>\r\n            <Badge\r\n              variant=\"solid\"\r\n              bg={\r\n                isCompletedToday\r\n                  ? \"green.500\"\r\n                  : `${colors.border.split(\".\")[0]}.500`\r\n              }\r\n              color=\"white\"\r\n              px={3}\r\n              py={1}\r\n              borderRadius=\"full\"\r\n              fontSize=\"xs\"\r\n              fontWeight=\"extrabold\"\r\n              letterSpacing=\"wider\"\r\n            >\r\n              {priority}\r\n            </Badge>\r\n\r\n            <Badge\r\n              variant=\"subtle\"\r\n              colorScheme=\"purple\"\r\n              px={3}\r\n              py={1}\r\n              borderRadius=\"full\"\r\n              fontSize=\"xs\"\r\n              fontWeight=\"bold\"\r\n            >\r\n              {type}\r\n            </Badge>\r\n          </HStack>\r\n\r\n          {/* Clock Display Format with Native Time Icon */}\r\n          <HStack spacing={1.5} color=\"gray.400\">\r\n            <TimeIcon boxSize=\"3.5px\" />\r\n            <Text fontSize=\"xs\" fontWeight=\"bold\" letterSpacing=\"wide\">\r\n              {format(new Date(startDate), \"HH:mm\")} &bull;{\" \"}\r\n              {format(new Date(startDate), \"dd MMM\")}\r\n            </Text>\r\n          </HStack>\r\n        </Flex>\r\n      </Flex>\r\n    </Box>\r\n  );\r\n}\r\n\r\nexport default React.memo(Action);\r\n","D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\nav\\auth\\ModalLogin.jsx",["282","283","284"],"import React, { useEffect, useState } from \"react\";\r\nimport {\r\n  Button,\r\n  Input,\r\n  FormControl,\r\n  FormLabel,\r\n  Modal,\r\n  ModalOverlay,\r\n  ModalContent,\r\n  ModalHeader,\r\n  ModalBody,\r\n  ModalFooter,\r\n  ModalCloseButton,\r\n  VStack,\r\n  useDisclosure,\r\n} from \"@chakra-ui/react\";\r\nimport \"./ModalLogin.css\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { useHistory } from \"react-router\";\r\nimport {\r\n  facebook_login,\r\n  google_login,\r\n  login_action,\r\n} from \"../../../actions/auth_actions\";\r\nimport isEmail from \"validator/lib/isEmail\";\r\nimport { toastr } from \"react-redux-toastr\";\r\n\r\nexport default function ModalLogin() {\r\n  const { isOpen, onOpen, onClose } = useDisclosure();\r\n  const [inputs, setInputs] = useState({ email: \"\", password: \"\" });\r\n\r\n  const { authenticated } = useSelector((state) => state.auth);\r\n  const { loading } = useSelector((state) => state.async);\r\n  const history = useHistory();\r\n  const dispatch = useDispatch();\r\n\r\n  const init = () => {\r\n    setInputs({ email: \"\", password: \"\" });\r\n    onClose();\r\n    history.push(history.location.pathname);\r\n  };\r\n\r\n  async function submitForm(e) {\r\n    e.preventDefault();\r\n    if (isEmail(inputs.email)) {\r\n      await dispatch(login_action(inputs));\r\n    } else {\r\n      toastr.error(\"error\", \"your email is not valid\");\r\n    }\r\n  }\r\n\r\n  useEffect(() => {\r\n    if (authenticated && !loading) {\r\n      init();\r\n    }\r\n  }, [authenticated, loading]);\r\n\r\n  const responseSuccesGoogle = (response) => {\r\n    dispatch(google_login({ tokenId: response.tokenId }));\r\n  };\r\n\r\n  const responseFacebook = (response) => {\r\n    dispatch(\r\n      facebook_login({\r\n        accessToken: response.accessToken,\r\n        userID: response.userID,\r\n      }),\r\n    );\r\n  };\r\n\r\n  const handleInputChange = (e) => {\r\n    setInputs({ ...inputs, [e.target.name]: e.target.value });\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <Button colorScheme=\"blue\" onClick={onOpen}>\r\n        Login\r\n      </Button>\r\n\r\n      <Modal isOpen={isOpen} onClose={init} isCentered size=\"md\">\r\n        <ModalOverlay backdropFilter=\"blur(4px)\" />\r\n        <ModalContent mx={4} borderRadius=\"xl\" boxShadow=\"2xl\" p={2}>\r\n          <ModalHeader fontSize=\"2xl\" fontWeight=\"bold\" color=\"gray.800\" pb={1}>\r\n            Welcome Back\r\n          </ModalHeader>\r\n          <ModalCloseButton top=\"20px\" right=\"20px\" />\r\n\r\n          <form onSubmit={submitForm}>\r\n            <ModalBody pt={4}>\r\n              <VStack spacing={5}>\r\n                {/* Email Field Wrapper */}\r\n                <FormControl isRequired>\r\n                  <FormLabel\r\n                    fontSize=\"sm\"\r\n                    fontWeight=\"semibold\"\r\n                    color=\"gray.600\"\r\n                    mb={2}\r\n                  >\r\n                    Email Address\r\n                  </FormLabel>\r\n                  <Input\r\n                    placeholder=\"name@example.com\"\r\n                    type=\"email\"\r\n                    name=\"email\"\r\n                    onChange={handleInputChange}\r\n                    value={inputs.email}\r\n                    size=\"lg\"\r\n                    bg=\"gray.50\"\r\n                    borderWidth=\"1px\"\r\n                    borderColor=\"gray.200\"\r\n                    borderRadius=\"md\"\r\n                    _focus={{\r\n                      bg: \"white\",\r\n                      borderColor: \"blue.500\",\r\n                      boxShadow: \"0 0 0 1px #3182ce\",\r\n                    }}\r\n                  />\r\n                </FormControl>\r\n\r\n                {/* Password Field Wrapper */}\r\n                <FormControl isRequired>\r\n                  <FormLabel\r\n                    fontSize=\"sm\"\r\n                    fontWeight=\"semibold\"\r\n                    color=\"gray.600\"\r\n                    mb={2}\r\n                  >\r\n                    Password\r\n                  </FormLabel>\r\n                  <Input\r\n                    placeholder=\"Enter your password\"\r\n                    type=\"password\"\r\n                    name=\"password\"\r\n                    onChange={handleInputChange}\r\n                    value={inputs.password}\r\n                    size=\"lg\"\r\n                    bg=\"gray.50\"\r\n                    borderWidth=\"1px\"\r\n                    borderColor=\"gray.200\"\r\n                    borderRadius=\"md\"\r\n                    _focus={{\r\n                      bg: \"white\",\r\n                      borderColor: \"blue.500\",\r\n                      boxShadow: \"0 0 0 1px #3182ce\",\r\n                    }}\r\n                  />\r\n                </FormControl>\r\n              </VStack>\r\n            </ModalBody>\r\n\r\n            <ModalFooter\r\n              flexDirection=\"column\"\r\n              alignItems=\"stretch\"\r\n              gap={4}\r\n              pt={6}\r\n            >\r\n              <VStack spacing={2} width=\"100%\">\r\n                <Button\r\n                  colorScheme=\"blue\"\r\n                  type=\"submit\"\r\n                  isLoading={loading}\r\n                  width=\"100%\"\r\n                  size=\"lg\"\r\n                  fontSize=\"md\"\r\n                  fontWeight=\"bold\"\r\n                  borderRadius=\"md\"\r\n                >\r\n                  Sign In\r\n                </Button>\r\n                <Button\r\n                  variant=\"ghost\"\r\n                  onClick={init}\r\n                  width=\"100%\"\r\n                  size=\"sm\"\r\n                  color=\"gray.500\"\r\n                >\r\n                  Cancel\r\n                </Button>\r\n              </VStack>\r\n            </ModalFooter>\r\n          </form>\r\n        </ModalContent>\r\n      </Modal>\r\n    </>\r\n  );\r\n}\r\n","D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\nav\\auth\\ModalRegister.jsx",["285"],"import React, { useEffect, useState } from \"react\";\r\nimport {\r\n  Button,\r\n  Input,\r\n  FormControl,\r\n  FormLabel,\r\n  Modal,\r\n  ModalOverlay,\r\n  ModalContent,\r\n  ModalHeader,\r\n  ModalBody,\r\n  ModalFooter,\r\n  ModalCloseButton,\r\n  VStack,\r\n  useDisclosure,\r\n} from \"@chakra-ui/react\";\r\nimport \"./ModalRegister.css\";\r\nimport { register_action } from \"../../../actions/auth_actions\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport ImageUpload from \"./ImageUpload\";\r\nimport isEmail from \"validator/lib/isEmail\";\r\nimport { toastr } from \"react-redux-toastr\";\r\n\r\nexport default function ModalRegister() {\r\n  const { isOpen, onOpen, onClose } = useDisclosure();\r\n  const [inputs, setInputs] = useState({\r\n    firstName: \"\",\r\n    lastName: \"\",\r\n    email: \"\",\r\n    password: \"\",\r\n    image: null,\r\n  });\r\n\r\n  const { loading } = useSelector((state) => state.async);\r\n  const { authenticated } = useSelector((state) => state.auth);\r\n  const dispatch = useDispatch();\r\n\r\n  function getFile(file) {\r\n    setInputs({ ...inputs, image: file });\r\n  }\r\n\r\n  useEffect(() => {\r\n    if (authenticated) onClose();\r\n  }, [authenticated]);\r\n\r\n  const handleInputChange = (e) => {\r\n    setInputs({ ...inputs, [e.target.name]: e.target.value });\r\n  };\r\n\r\n  function submitForm(e) {\r\n    e.preventDefault();\r\n    const formData = new FormData();\r\n\r\n    formData.append(\"firstName\", inputs.firstName);\r\n    formData.append(\"lastName\", inputs.lastName);\r\n\r\n    if (isEmail(inputs.email)) {\r\n      formData.append(\"email\", inputs.email);\r\n    } else {\r\n      toastr.error(\"error\", \"your email is not valid\");\r\n      return;\r\n    }\r\n\r\n    if (inputs.password.length > 4) {\r\n      formData.append(\"password\", inputs.password);\r\n    } else {\r\n      toastr.error(\"error\", \"your password should be more than 4 characters\");\r\n      return;\r\n    }\r\n\r\n    formData.append(\"image\", inputs.image);\r\n    dispatch(register_action(formData));\r\n  }\r\n\r\n  return (\r\n    <>\r\n      <Button colorScheme=\"green\" onClick={onOpen}>\r\n        Register\r\n      </Button>\r\n\r\n      <Modal isOpen={isOpen} onClose={onClose} isCentered>\r\n        <ModalOverlay />\r\n        <ModalContent mx={4}>\r\n          <ModalHeader>Create your account</ModalHeader>\r\n          <ModalCloseButton />\r\n\r\n          <form onSubmit={submitForm}>\r\n            <ModalBody>\r\n              <VStack spacing={4}>\r\n                <FormControl isRequired>\r\n                  <FormLabel>First Name</FormLabel>\r\n                  <Input\r\n                    placeholder=\"First Name\"\r\n                    name=\"firstName\"\r\n                    onChange={handleInputChange}\r\n                    value={inputs.firstName}\r\n                  />\r\n                </FormControl>\r\n\r\n                <FormControl isRequired>\r\n                  <FormLabel>Last Name</FormLabel>\r\n                  <Input\r\n                    placeholder=\"Last Name\"\r\n                    name=\"lastName\"\r\n                    onChange={handleInputChange}\r\n                    value={inputs.lastName}\r\n                  />\r\n                </FormControl>\r\n\r\n                <FormControl>\r\n                  <FormLabel>Profile Picture</FormLabel>\r\n                  <ImageUpload\r\n                    id=\"image\"\r\n                    className=\"productForm_picBtn\"\r\n                    getFile={getFile}\r\n                  />\r\n                </FormControl>\r\n\r\n                <FormControl isRequired>\r\n                  <FormLabel>Email</FormLabel>\r\n                  <Input\r\n                    placeholder=\"Email\"\r\n                    type=\"email\"\r\n                    name=\"email\"\r\n                    onChange={handleInputChange}\r\n                    value={inputs.email}\r\n                  />\r\n                </FormControl>\r\n\r\n                <FormControl isRequired>\r\n                  <FormLabel>Password</FormLabel>\r\n                  <Input\r\n                    placeholder=\"Password\"\r\n                    type=\"password\"\r\n                    name=\"password\"\r\n                    onChange={handleInputChange}\r\n                    value={inputs.password}\r\n                  />\r\n                </FormControl>\r\n              </VStack>\r\n            </ModalBody>\r\n\r\n            <ModalFooter gap={3}>\r\n              <Button variant=\"ghost\" onClick={onClose} width=\"50%\">\r\n                Cancel\r\n              </Button>\r\n              <Button\r\n                colorScheme=\"green\"\r\n                type=\"submit\"\r\n                isLoading={loading}\r\n                width=\"50%\"\r\n              >\r\n                Submit\r\n              </Button>\r\n            </ModalFooter>\r\n          </form>\r\n        </ModalContent>\r\n      </Modal>\r\n    </>\r\n  );\r\n}\r\n","D:\\My projects\\Make-it-happen\\development\\client\\src\\actions\\config.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\actions\\async_actions.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\nav\\auth\\ImageUpload.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\actions\\promodoro_actions.js",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\action\\ModalEditAction.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\action\\ModalDeleteAction.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\field\\ModalEditField.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\field\\ModalDeleteField.jsx",[],"D:\\My projects\\Make-it-happen\\development\\client\\src\\components\\goal\\GoalMT.jsx",[],"D:\\My projects\\Make-it-happen\\development\\cli